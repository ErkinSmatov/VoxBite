# DATABASE_URL — где взять:
# Supabase Dashboard -> Connect (или Project Settings -> Database) ->
# Connection string -> вкладка "Session pooler". Замени плейсхолдер
# [YOUR-PASSWORD] на реальный пароль от базы данных. Не убирай
# "?sslmode=require" в конце строки — без него соединение не будет
# зашифровано.
DATABASE_URL=postgres://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# OPENAI_API_KEY — где взять:
# https://platform.openai.com/api-keys -> "Create new secret key".
# Ключ показывается только один раз — сразу сохрани его в этот файл.
OPENAI_API_KEY=sk-proj-REPLACE_ME
